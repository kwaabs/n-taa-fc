# ─────────────────────────────────────────────
# Go API
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5442
API_ENV=development
API_LOG_LEVEL=info

# ─────────────────────────────────────────────
# Database (shared ntaafc DB — geo_app role from bootstrap.sql)
# ─────────────────────────────────────────────
DATABASE_URL=postgres://geo_app:geo_app_dev_pw@localhost:5350/ntaafc?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# ─────────────────────────────────────────────
# CORS (geo-web runs on 5357)
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5357,http://localhost:3000

MARTIN_BASE_URL=http://localhost:5360

# ─────────────────────────────────────────────
# Shared GoTrue JWT (MUST match GOTRUE_JWT_SECRET / FC JWT_SECRET)
# ─────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-me-in-production

# First GoTrue login with this email becomes active superuser in app.users
# Break-glass geo superuser (also: any FC is_system_admin is elevated automatically)
SUPERUSER_EMAIL=admin@geo.local
SUPERUSER_NAME=Super Admin

# Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Shared RustFS (same bucket as FC) — for viewing field-collected media
S3_ENDPOINT=http://localhost:5352
S3_PUBLIC_ENDPOINT=http://localhost:5352
S3_BUCKET=field-collector
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
