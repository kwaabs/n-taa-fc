# Server
PORT=5355
ENV=development

# Database (shared ntaafc DB — supabase/postgres superuser is supabase_admin)
DATABASE_URL=postgres://supabase_admin:ntaafc@localhost:5350/ntaafc?sslmode=disable

# JWT (must match GoTrue GOTRUE_JWT_SECRET in infra/docker-compose.yml)
JWT_SECRET=super-secret-jwt-key-change-me-in-production

# CORS
CORS_ORIGINS=http://localhost:5356,http://localhost:3000

# S3 / RustFS
S3_ENDPOINT=http://localhost:5352
S3_PUBLIC_ENDPOINT=http://localhost:5352
S3_BUCKET=field-collector
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_USE_SSL=false

# Valkey (Redis-compatible) — FC uses bundle:* key prefix
VALKEY_URL=redis://localhost:5351
VALKEY_PASSWORD=
VALKEY_DB=0

# GoTrue
GOTRUE_URL=http://localhost:5354

# Tippecanoe
TIPPECANOE_URL=http://localhost:5361

# OAuth for GoTrue lives in the repo-root .env (AZURE_* / GOOGLE_*),
# not here — compose injects those into the gotrue service.
