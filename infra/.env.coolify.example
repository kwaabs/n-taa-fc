# Coolify → Environment Variables (no scheme, no path on *_HOST)
# Magic SERVICE_PASSWORD_* values are auto-generated by Coolify on first deploy
# if you leave them empty in the UI — do not commit real secrets.

FC_WEB_HOST=fc.example.com
GEO_WEB_HOST=geo.example.com
FC_API_HOST=fc-api.example.com
GOTRUE_HOST=auth.example.com
MARTIN_HOST=tiles.example.com
S3_HOST=s3.example.com

# OAuth (GoTrue)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_NAME=Super Admin
S3_ACCESS_KEY=rustfsadmin
S3_BUCKET=field-collector

# Coolify magic (auto-filled if omitted)
# SERVICE_PASSWORD_POSTGRES=
# SERVICE_PASSWORD_GEOAPP=
# SERVICE_PASSWORD_JWT=
# SERVICE_PASSWORD_RUSTFS=
